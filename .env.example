# HOTEL YASH GRAND — Enterprise Production Environment Variables Schema

# ==========================================
# 1. APPLICATION & DOMAIN CONFIGURATION
# ==========================================
NEXT_PUBLIC_SITE_URL=https://hotelyashgrand.com
NEXT_PUBLIC_API_URL=https://hotelyashgrand.com
NEXT_PUBLIC_WHATSAPP_PHONE=919151088115
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ==========================================
# 2. POSTGRESQL DATABASE & CONNECTION POOL
# ==========================================
# Managed PostgreSQL Connection Pooler URL (e.g., PgBouncer / Supabase Pooler)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/yashgrand?pgbouncer=true&connection_limit=20
# Direct Database URL for Prisma Migrations
DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/yashgrand

# ==========================================
# 3. AUTHENTICATION & SECURITY KEYS
# ==========================================
NEXTAUTH_URL=https://hotelyashgrand.com
NEXTAUTH_SECRET=e7b4c9a1d3f82e5091a4c6b8f2d1e037495a8b2c1d4e7f9a0b3c6d9e2f5a8b1c
JWT_SECRET=f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==========================================
# 4. PAYMENT GATEWAY (RAZORPAY)
# ==========================================
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ==========================================
# 5. MULTI-CHANNEL NOTIFICATIONS
# ==========================================
# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yashgrand03nov@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM_EMAIL=reservations@hotelyashgrand.com

# WhatsApp & DLT SMS API Keys
WHATSAPP_API_TOKEN=your-whatsapp-business-api-token
DLT_SMS_API_KEY=your-dlt-sms-gateway-api-key
DLT_SMS_SENDER_ID=YSHGRD

# ==========================================
# 6. OBJECT STORAGE (S3 / CLOUDFLARE R2)
# ==========================================
AWS_S3_BUCKET=yashgrand-production-media
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
CDN_PUBLIC_DOMAIN=https://media.hotelyashgrand.com
