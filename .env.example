# HOTEL YASH GRAND — Vercel Production Environment Variables Template
# Copy this file to .env.local for local development or input into Vercel Project Settings

# ==========================================
# 1. APPLICATION & DOMAIN CONFIGURATION
# ==========================================
# Primary public production site URL (used for SEO tags, auth callbacks & sitemaps)
NEXT_PUBLIC_SITE_URL=https://hotelyashgrand.com

# Base API domain URL (Optional if using relative Next.js API routes)
NEXT_PUBLIC_API_URL=https://hotelyashgrand.com

# Customer Support WhatsApp Hotline (Format: Country code + Mobile number without +)
NEXT_PUBLIC_WHATSAPP_PHONE=919876543210

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ==========================================
# 2. DATABASE & PRISMA ORM
# ==========================================
# Managed PostgreSQL Connection Pooler URL (e.g., Supabase / Neon / PgBouncer)
DATABASE_URL=postgresql://user:password@host:6543/dbname?pgbouncer=true&connection_limit=20

# Direct PostgreSQL Connection URL (Used for Prisma schema migrations)
DIRECT_URL=postgresql://user:password@host:5432/dbname

# ==========================================
# 3. AUTHENTICATION & SECURITY KEYS
# ==========================================
# Canonical Authentication URL (Must match your Vercel deployment domain)
NEXTAUTH_URL=https://hotelyashgrand.com

# Auth.js / NextAuth Session Encryption Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET=your-nextauth-auth-secret-key-placeholder
NEXTAUTH_SECRET=your-nextauth-auth-secret-key-placeholder

# Management Portal & API JWT Token Signing Secret
JWT_SECRET=your-jwt-secret-signing-key-placeholder

# Google OAuth 2.0 Credentials (Optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-placeholder

# ==========================================
# 4. PAYMENT GATEWAY (RAZORPAY)
# ==========================================
# Razorpay Key ID (Client-side key prefixed with rzp_live_ or rzp_test_)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id_placeholder

# Razorpay Key Secret (Server-side key)
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-placeholder

# Razorpay Webhook Secret (For payment verification events)
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret-placeholder

# ==========================================
# 5. MULTI-CHANNEL NOTIFICATIONS
# ==========================================
# SMTP Email Transport Settings
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username-placeholder
SMTP_PASS=your-smtp-password-placeholder
SMTP_FROM_EMAIL=reservations@hotelyashgrand.com

# Meta WhatsApp Business Cloud API Settings (Optional)
WHATSAPP_API_TOKEN=your-whatsapp-business-api-token-placeholder
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id-placeholder

# DLT SMS Gateway Settings (India Compliant, Optional)
DLT_SMS_API_KEY=your-dlt-sms-gateway-api-key-placeholder
DLT_SMS_SENDER_ID=YSHGRD

# ==========================================
# 6. OBJECT STORAGE & MEDIA CDN
# ==========================================
# AWS S3 / Cloudflare R2 Media Storage (Optional)
AWS_S3_BUCKET=yashgrand-production-media
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id-placeholder
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-placeholder
CDN_PUBLIC_DOMAIN=https://media.hotelyashgrand.com
